# Where the gateway forwards sanitized requests (any OpenAI-compatible API).
# "mock" = offline mode, no API key needed (the fake LLM echoes what it got).
UPSTREAM_BASE_URL=mock
# OpenAI:             UPSTREAM_BASE_URL=https://api.openai.com/v1
# Groq (free tier):   UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
# Gemini (free tier): UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
UPSTREAM_API_KEY=
UPSTREAM_MODEL=            # e.g. llama-3.1-8b-instant (Groq) or gemini-2.0-flash

# Optional: require clients to send "Authorization: Bearer <key>"
GATEWAY_API_KEY=

SPACY_MODEL=en_core_web_lg
POLICY_PATH=policy.yaml
AUDIT_LOG_PATH=audit.log
DETECTION_TIMEOUT_S=5
REDACT_RESPONSE_PII=false  # true = also redact PII the model writes itself
ENABLE_DEBUG=true          # /debug/sanitize endpoint; set false in production
ENABLE_GLINER=false        # compare with NVIDIA GLiNER on the demo page; see requirements-gliner.txt
GLINER_URL=                # or use our Cloud Run service instead (see gliner_service/); needs no local install
GLINER_TOKEN=              # the shared secret that service expects
